{
  "version": 2,
  "env": {
    "GITHUB_TOKEN": "@GITHUB_TOKEN",
    "GITHUB_OWNER": "@GITHUB_OWNER",
    "GITHUB_REPO": "@GITHUB_REPO",
    "GITHUB_BRANCH": "@GITHUB_BRANCH",
    "JWT_SECRET": "@JWT_SECRET"
  },
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x",
      "memory": 256,
      "maxDuration": 10
    }
  },
  "buildCommand": "echo 'Build complete'",
  "outputDirectory": "./"
}
